{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.gtav-riding-companion.invalid/v1/map.schema.json",
  "title": "GET /api/v1/map",
  "type": "object",
  "additionalProperties": false,
  "required": ["assetId", "calibrationRevision", "width", "height", "sequence", "position", "route"],
  "properties": {
    "assetId": { "type": "string", "pattern": "^map-[0-9a-f]{64}$" },
    "calibrationRevision": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "width": { "type": "integer", "minimum": 32, "maximum": 8192 },
    "height": { "type": "integer", "minimum": 32, "maximum": 8192 },
    "sequence": { "type": "integer", "minimum": 0 },
    "position": { "$ref": "#/$defs/point" },
    "route": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["id", "reverse", "waypoints"],
      "properties": {
        "id": { "type": "string", "pattern": "^[1-9][0-9]{0,4}$" },
        "reverse": { "type": "boolean" },
        "waypoints": {
          "description": "Native waypoints in riding order, not a calculated road path. A null point breaks the line.",
          "type": "array",
          "minItems": 1,
          "maxItems": 512,
          "items": { "$ref": "#/$defs/point" }
        }
      }
    }
  },
  "$defs": {
    "point": {
      "description": "Coordinates normalized to the selected PNG from its top-left. Null means outside coverage or unavailable.",
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["u", "v"],
      "properties": {
        "u": { "type": "number", "minimum": 0, "exclusiveMaximum": 1 },
        "v": { "type": "number", "minimum": 0, "exclusiveMaximum": 1 }
      }
    }
  }
}
