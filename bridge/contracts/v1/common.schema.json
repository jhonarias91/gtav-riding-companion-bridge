{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.gtav-riding-companion.invalid/v1/common.schema.json",
  "title": "GTAV Riding Companion bridge v1 - shared definitions",
  "description": "P0 proposal. Shared types for the native Android contract. Not an official GTBike V API.",
  "$defs": {
    "opaqueId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "requestId": {
      "description": "UUID generated by the client. Lowercase canonical form.",
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "utcTimestamp": {
      "description": "UTC ISO 8601 with mandatory Z suffix.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,7})?Z$"
    },
    "reasonCode": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
    },
    "helpId": {
      "description": "Key into Android local help resources (AYUDA_CONTEXTUAL.md). The server never sends help copy.",
      "type": "string",
      "pattern": "^[a-z][A-Za-z0-9]*(\\.[a-z][A-Za-z0-9]*)+$"
    },
    "deviceId": {
      "description": "C# ulong as decimal string; never a JSON number.",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "quality": {
      "enum": ["valid", "unavailable", "stale"]
    },
    "metricSource": {
      "enum": ["ANT", "BLE", "virtual", "game", "derived", "unknown"]
    },
    "receiverState": {
      "description": "Mirror of private enum DataTransceiver.ReceiverState (DataTransceiver.cs:1662), lowercased, plus unknown.",
      "enum": ["uninitialized", "initialized", "started", "complete", "ready", "stopping", "stopped", "error", "unknown"]
    },
    "modLayer": {
      "enum": ["inactive", "initializing", "dataReady", "stopping", "error", "unknown"]
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "quality"],
      "properties": {
        "value": { "type": ["number", "null"] },
        "quality": { "$ref": "#/$defs/quality" },
        "source": { "$ref": "#/$defs/metricSource" },
        "reasonCode": { "anyOf": [{ "$ref": "#/$defs/reasonCode" }, { "type": "null" }] }
      },
      "allOf": [
        {
          "if": { "properties": { "quality": { "const": "valid" } } },
          "then": { "properties": { "value": { "type": "number" } } }
        },
        {
          "if": { "properties": { "quality": { "const": "unavailable" } } },
          "then": {
            "required": ["reasonCode"],
            "properties": { "value": { "type": "null" }, "reasonCode": { "$ref": "#/$defs/reasonCode" } }
          }
        }
      ]
    },
    "errorBody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "helpId", "retryable", "operationId", "details"],
      "properties": {
        "code": { "$ref": "#/$defs/serverErrorCode" },
        "helpId": { "anyOf": [{ "$ref": "#/$defs/helpId" }, { "type": "null" }] },
        "retryable": { "type": "boolean" },
        "operationId": { "anyOf": [{ "$ref": "#/$defs/opaqueId" }, { "type": "null" }] },
        "details": {
          "description": "Sanitized, typed details. No paths, stack traces, full device addresses or raw upstream messages.",
          "type": "object",
          "maxProperties": 8,
          "propertyNames": { "pattern": "^[a-z][A-Za-z0-9]{0,31}$" },
          "additionalProperties": {
            "anyOf": [
              { "type": "string", "maxLength": 128 },
              { "type": "number" },
              { "type": "boolean" },
              { "type": "null" }
            ]
          }
        }
      }
    },
    "serverErrorCode": {
      "description": "Codes the bridge may emit. Client-only codes (LAN_PERMISSION_DENIED, PC_UNREACHABLE, TLS_IDENTITY_MISMATCH) never travel over the wire.",
      "enum": [
        "INVALID_REQUEST",
        "PAYLOAD_TOO_LARGE",
        "AUTH_REQUIRED",
        "FORBIDDEN_SCOPE",
        "PAIRING_PIN_INVALID",
        "PAIRING_PIN_EXPIRED",
        "RATE_LIMITED",
        "NOT_FOUND",
        "ADAPTER_ABSENT",
        "ADAPTER_STALE",
        "UNSUPPORTED_VERSION",
        "CAPABILITY_UNAVAILABLE",
        "REVISION_CONFLICT",
        "INSTANCE_CHANGED",
        "MOD_TRANSITION_IN_PROGRESS",
        "GAME_NOT_IN_CONTROL",
        "DEVICE_CHANGED",
        "WORKOUT_PC_CONTROL_REQUIRED",
        "SAVE_TOO_SHORT",
        "OPERATION_UNKNOWN",
        "FIT_INVALID",
        "ASSET_UNAVAILABLE",
        "MOD_INACTIVE",
        "MOD_NOT_LOADED",
        "PANEL_CLOSED",
        "RIDER_MOVING",
        "AUTOPILOT_ON",
        "VALUE_OUT_OF_RANGE",
        "VALUE_NOT_ALLOWED",
        "BRIDGE_BUSY",
        "INTERNAL"
      ]
    }
  }
}
