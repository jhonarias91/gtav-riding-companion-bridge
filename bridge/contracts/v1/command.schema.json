{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.gtav-riding-companion.invalid/v1/command.schema.json",
  "title": "POST /api/v1/commands",
  "$comment": "v1.15 adds camera.next (the NextCamKey control pulse), camera.setMode and camera.look. Real mod activation also closes native menus and suppresses immediate auto-open. No generic keyboard command is exposed.",
  "description": "Typed allowlist. v1.0: mod.setActive (P2). v1.1: routes and UI panel (P3). v1.2: profile, ride settings and appearance (P4). v1.3: devices.configure (P5). v1.5: activities.finish (P7). v1.7: devices.assign (P11). v1.9: devices.disconnect (P12). v1.10: workouts.select (P13, the native Select path only; pause, skip, end, ERG, target and bias stay forbidden). v1.12: player.teleport (P16, PC window only; phones get FORBIDDEN_SCOPE). v1.13: player.waypoint and player.clearWaypoint (P17, PC window only). v1.14: addons.setEnabled, addons.configure, addons.saveSegment, addons.removeSegment, addons.savePlace and addons.removePlace (P18, phones and PC; parameters typed by GET /api/v1/addons). P6 adds reads only. The forbidden list in policy.json can never be added. Max body 64 KiB. The server assigns timestamps and TTL; client time is ignored.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requestId",
    "adapterInstanceId",
    "type",
    "expectedRevision",
    "args"
  ],
  "properties": {
    "requestId": {
      "$ref": "common.schema.json#/$defs/requestId"
    },
    "adapterInstanceId": {
      "$ref": "common.schema.json#/$defs/opaqueId"
    },
    "type": {
      "$ref": "#/$defs/commandType"
    },
    "expectedRevision": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/opaqueId"
        },
        {
          "type": "null"
        }
      ]
    },
    "args": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "enum": ["gears.shiftUp", "gears.shiftDown"] } } },
      "then": { "properties": { "expectedRevision": { "type": "null" }, "args": { "type": "object", "additionalProperties": false } } }
    },
    {
      "if": { "properties": { "type": { "const": "camera.next" } } },
      "then": { "properties": { "expectedRevision": { "type": "null" }, "args": { "type": "object", "additionalProperties": false } } }
    },
    {
      "if": { "properties": { "type": { "const": "camera.setMode" } } },
      "then": { "properties": { "expectedRevision": { "type": "null" }, "args": {
        "type": "object", "additionalProperties": false, "required": ["mode"],
        "properties": { "mode": { "enum": ["near", "medium", "far", "firstPerson", "cinematic"] } }
      } } }
    },
    {
      "if": { "properties": { "type": { "const": "camera.look" } } },
      "then": { "properties": { "expectedRevision": { "type": "null" }, "args": {
        "type": "object", "additionalProperties": false, "required": ["headingDeg", "pitchDeg"],
        "properties": { "headingDeg": { "type": "number", "minimum": -180, "maximum": 180 }, "pitchDeg": { "type": "number", "minimum": -45, "maximum": 45 } }
      } } }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "mod.setActive"
          }
        }
      },
      "then": {
        "properties": {
          "args": {
            "description": "Semantic target state, never a blind toggle. The adapter invokes the native toggle only when the observed state differs and no receiver is transitioning.",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "enabled"
            ],
            "properties": {
              "enabled": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "routes.apply"
          }
        }
      },
      "then": {
        "properties": {
          "expectedRevision": {
            "description": "catalogRevision the phone browsed.",
            "$ref": "common.schema.json#/$defs/opaqueId"
          },
          "args": {
            "description": "routeId null = free ride (clears the course). loop/reverse only for routes whose catalog entry allows them; reverse requires a loop-capable route (CourseSelectionView.cs _liw_OnListChanged).",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "routeId",
              "loop",
              "reverse"
            ],
            "properties": {
              "routeId": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/routeId"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "loop": {
                "type": "boolean"
              },
              "reverse": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "routes.preview"
          }
        }
      },
      "then": {
        "properties": {
          "expectedRevision": {
            "description": "catalogRevision.",
            "$ref": "common.schema.json#/$defs/opaqueId"
          },
          "args": {
            "description": "Moves the open PC route selector to this route. Never applies it.",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "routeId"
            ],
            "properties": {
              "routeId": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/routeId"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "ui.openPanel"
          }
        }
      },
      "then": {
        "properties": {
          "args": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "panel"
            ],
            "properties": {
              "panel": {
                "$ref": "#/$defs/panel"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "ui.closePanel"
          }
        }
      },
      "then": {
        "properties": {
          "args": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "panel"
            ],
            "properties": {
              "panel": {
                "$ref": "#/$defs/panel"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "profile.update"
          }
        }
      },
      "then": {
        "properties": {
          "expectedRevision": {
            "description": "settingsRevision.",
            "$ref": "common.schema.json#/$defs/opaqueId"
          },
          "args": {
            "description": "Only the fields to change; at least one. Ranges mirror the native setters, which silently replace out-of-range values with defaults (Config.cs:90-140), so they are rejected here instead.",
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "properties": {
              "weightKg": {
                "type": "integer",
                "minimum": 40,
                "maximum": 150
              },
              "ftpW": {
                "type": "integer",
                "minimum": 50,
                "maximum": 500
              },
              "hrMaxBpm": {
                "type": "integer",
                "minimum": 50,
                "maximum": 220
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "rideSettings.update"
          }
        }
      },
      "then": {
        "properties": {
          "expectedRevision": {
            "description": "settingsRevision.",
            "$ref": "common.schema.json#/$defs/opaqueId"
          },
          "args": {
            "description": "Only the fields to change; at least one. difficulty is the native DifficultyLevel list (Menus.cs:283): 255 = disabled. No power target, gear or bias.",
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "properties": {
              "autopilot": {
                "type": "boolean"
              },
              "avoidObstacles": {
                "type": "boolean"
              },
              "difficulty": {
                "enum": [
                  0,
                  25,
                  50,
                  75,
                  100,
                  255
                ]
              },
              "roadFeel": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "appearance.select"
          }
        }
      },
      "then": {
        "properties": {
          "expectedRevision": {
            "description": "settingsRevision (catalog of bikes and characters).",
            "$ref": "common.schema.json#/$defs/opaqueId"
          },
          "args": {
            "description": "Exactly one of bikeId / characterId, taken from GET /api/v1/settings.",
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "maxProperties": 1,
            "properties": {
              "bikeId": {
                "$ref": "#/$defs/catalogKey"
              },
              "characterId": {
                "$ref": "#/$defs/catalogKey"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "devices.configure"
          }
        }
      },
      "then": {
        "properties": {
          "expectedRevision": {
            "description": "devicesRevision the phone saw.",
            "$ref": "common.schema.json#/$defs/opaqueId"
          },
          "args": {
            "description": "Same three actions as the native Device Selection view (DeviceSelectionAction: Skip, Lock, Auto). Lock and Skip name the device the user saw; if the PC now uses another one the bridge answers DEVICE_CHANGED.",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "role",
              "action",
              "expectedDeviceId",
              "expectedSource"
            ],
            "properties": {
              "role": {
                "$ref": "#/$defs/sensorRole"
              },
              "action": {
                "enum": [
                  "auto",
                  "lock",
                  "skip"
                ]
              },
              "expectedDeviceId": {
                "anyOf": [
                  {
                    "$ref": "common.schema.json#/$defs/deviceId"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "expectedSource": {
                "enum": [
                  "ANT",
                  "BLE",
                  null
                ]
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "action": {
                      "const": "auto"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "expectedDeviceId": {
                      "type": "null"
                    },
                    "expectedSource": {
                      "type": "null"
                    }
                  }
                },
                "else": {
                  "properties": {
                    "expectedDeviceId": {
                      "$ref": "common.schema.json#/$defs/deviceId"
                    },
                    "expectedSource": {
                      "enum": [
                        "ANT",
                        "BLE"
                      ]
                    }
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "devices.assign"
          }
        }
      },
      "then": {
        "properties": {
          "expectedRevision": {
            "description": "devicesRevision the phone saw.",
            "$ref": "common.schema.json#/$defs/opaqueId"
          },
          "args": {
            "description": "P11. Locks a BLE sensor the phone saw advertising for one role, through the mod's own DeviceInfo.ChangeDeviceConfig (the rule the native Lock button writes). The phone never connects to the sensor; the PC does. The bridge rejects sensor types that cannot serve the role (VALUE_NOT_ALLOWED).",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "role",
              "sensorType",
              "deviceId"
            ],
            "properties": {
              "role": {
                "$ref": "#/$defs/sensorRole"
              },
              "sensorType": {
                "$ref": "#/$defs/assignSensorType"
              },
              "deviceId": {
                "$ref": "#/$defs/bleAddress"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "devices.disconnect"
          }
        }
      },
      "then": {
        "properties": {
          "expectedRevision": {
            "description": "devicesRevision the phone saw.",
            "$ref": "common.schema.json#/$defs/opaqueId"
          },
          "args": {
            "description": "P12. The PC drops a BLE sensor it uses now: roles locked to that address go back to the mod's Auto and the receiver stops accepting that sensor type until the user connects one from the phone or the mod restarts. Only BLE; a sensor the PC is not using is rejected with DEVICE_CHANGED.",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sensorType",
              "deviceId"
            ],
            "properties": {
              "sensorType": {
                "$ref": "#/$defs/assignSensorType"
              },
              "deviceId": {
                "$ref": "#/$defs/bleAddress"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "activities.finish"
          }
        }
      },
      "then": {
        "properties": {
          "expectedRevision": {
            "description": "sessionGeneration of the activity the user wants to save.",
            "$ref": "common.schema.json#/$defs/opaqueId"
          },
          "args": {
            "description": "Saves the current activity like the native Save menu item. No discard, upload or delete.",
            "type": "object",
            "additionalProperties": false,
            "maxProperties": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "workouts.select"
          }
        }
      },
      "then": {
        "properties": {
          "expectedRevision": {
            "description": "catalogRevision of the workout list the phone browsed (GET /api/v1/workout-plans).",
            "$ref": "common.schema.json#/$defs/opaqueId"
          },
          "args": {
            "description": "P13. Selects and starts a workout exactly like the Select button of the mod's workout selector: the mod sets it on the current activity, starts its countdown and engages ERG itself. A workout already running is replaced, as the mod menu does (not ended or saved; the activity goes on). There is no pause, skip, end, ERG, target or bias command.",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "workoutId"
            ],
            "properties": {
              "workoutId": {
                "type": "string",
                "pattern": "^w-[a-f0-9]{16}$"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "player.teleport"
          }
        }
      },
      "then": {
        "properties": {
          "expectedRevision": {
            "type": "null"
          },
          "args": {
            "description": "P16. PC window only (loopback desktop token); a phone gets FORBIDDEN_SCOPE. Raw GTA world metres. The adapter streams the area, puts the rider (and the bike under them) on the ground, on the nearest road within 60 m when there is one, and puts them back on open water or after about 12 s without ground. Refused during a course (VALUE_NOT_ALLOWED).",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "x",
              "y"
            ],
            "properties": {
              "x": {
                "type": "number",
                "minimum": -10000,
                "maximum": 10000
              },
              "y": {
                "type": "number",
                "minimum": -10000,
                "maximum": 10000
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "player.waypoint"
          }
        }
      },
      "then": {
        "properties": {
          "expectedRevision": {
            "type": "null"
          },
          "args": {
            "description": "P17. PC window only (loopback desktop token); a phone gets FORBIDDEN_SCOPE. Sets GTA's own map waypoint at these GTA world metres, so the game draws its GPS route on the minimap (like a waypoint chosen in the pause map). Replaces any waypoint. Refused during a course (VALUE_NOT_ALLOWED).",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "x",
              "y"
            ],
            "properties": {
              "x": {
                "type": "number",
                "minimum": -10000,
                "maximum": 10000
              },
              "y": {
                "type": "number",
                "minimum": -10000,
                "maximum": 10000
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "player.clearWaypoint"
          }
        }
      },
      "then": {
        "properties": {
          "expectedRevision": {
            "type": "null"
          },
          "args": {
            "description": "P17. PC window only. Removes GTA's map waypoint and its GPS route; already none is applied at once.",
            "type": "object",
            "additionalProperties": false,
            "maxProperties": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "addons.setEnabled"
          }
        }
      },
      "then": {
        "description": "P18. Starting needs expectedRevision = addonsRevision (the parameters the client saw); stopping needs null and is always allowed with a fresh adapter.",
        "if": {
          "properties": {
            "args": {
              "properties": {
                "enabled": {
                  "const": true
                }
              }
            }
          }
        },
        "then": {
          "properties": {
            "expectedRevision": {
              "$ref": "common.schema.json#/$defs/opaqueId"
            }
          }
        },
        "else": {
          "properties": {
            "expectedRevision": {
              "type": "null"
            }
          }
        },
        "properties": {
          "args": {
            "description": "P18. Start (enabled true) or stop (false) one add-on. Evidence: the add-on reaches 'running' tagged with this requestId, or is no longer preparing/running.",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "addonId",
              "enabled"
            ],
            "properties": {
              "addonId": {
                "$ref": "addons.schema.json#/$defs/addonId"
              },
              "enabled": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "addons.configure"
          }
        }
      },
      "then": {
        "properties": {
          "expectedRevision": {
            "$ref": "common.schema.json#/$defs/opaqueId"
          },
          "args": {
            "description": "P18. Changed parameters only, each typed and bounded by its descriptor in GET /api/v1/addons (the bridge checks type, min, max, step and options). Parameters with liveEdit false are refused while the add-on runs (VALUE_NOT_ALLOWED).",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "addonId",
              "params"
            ],
            "properties": {
              "addonId": {
                "$ref": "addons.schema.json#/$defs/addonId"
              },
              "params": {
                "type": "object",
                "minProperties": 1,
                "maxProperties": 24,
                "propertyNames": {
                  "pattern": "^[a-z][a-zA-Z0-9]{0,31}$"
                },
                "additionalProperties": {
                  "type": [
                    "number",
                    "boolean",
                    "string"
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "addons.saveSegment"
          }
        }
      },
      "then": {
        "properties": {
          "expectedRevision": {
            "type": "null"
          },
          "args": {
            "description": "P18 ghost. Creates (segmentId null; the bridge assigns seg-<hex>) or updates a timed segment. Start and finish are GTA world metres; the same point twice is a loop. Moving a point of an existing segment resets its record. At most 50 segments (VALUE_NOT_ALLOWED). Refused for the segment whose attempt is running.",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "addonId",
              "segmentId",
              "name",
              "start",
              "finish"
            ],
            "properties": {
              "addonId": {
                "$ref": "addons.schema.json#/$defs/addonId"
              },
              "segmentId": {
                "anyOf": [
                  {
                    "$ref": "addons.schema.json#/$defs/segmentId"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              "start": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "x",
                  "y"
                ],
                "properties": {
                  "x": {
                    "type": "number",
                    "minimum": -10000,
                    "maximum": 10000
                  },
                  "y": {
                    "type": "number",
                    "minimum": -10000,
                    "maximum": 10000
                  }
                }
              },
              "finish": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "x",
                  "y"
                ],
                "properties": {
                  "x": {
                    "type": "number",
                    "minimum": -10000,
                    "maximum": 10000
                  },
                  "y": {
                    "type": "number",
                    "minimum": -10000,
                    "maximum": 10000
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "addons.removeSegment"
          }
        }
      },
      "then": {
        "properties": {
          "expectedRevision": {
            "type": "null"
          },
          "args": {
            "description": "P18 ghost. Removes a segment with its record and ghost traces.",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "addonId",
              "segmentId"
            ],
            "properties": {
              "addonId": {
                "$ref": "addons.schema.json#/$defs/addonId"
              },
              "segmentId": {
                "$ref": "addons.schema.json#/$defs/segmentId"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "addons.savePlace"
          }
        }
      },
      "then": {
        "properties": {
          "expectedRevision": {
            "type": "null"
          },
          "args": {
            "description": "P18 discover. Creates (placeId null; the bridge assigns pl-<hex>) or renames/moves a saved place (GTA world metres). At most 100 (VALUE_NOT_ALLOWED). The place being searched right now cannot be moved or removed.",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "addonId",
              "placeId",
              "name",
              "point"
            ],
            "properties": {
              "addonId": {
                "$ref": "addons.schema.json#/$defs/addonId"
              },
              "placeId": {
                "anyOf": [
                  {
                    "$ref": "addons.schema.json#/$defs/placeId"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              "point": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "x",
                  "y"
                ],
                "properties": {
                  "x": {
                    "type": "number",
                    "minimum": -10000,
                    "maximum": 10000
                  },
                  "y": {
                    "type": "number",
                    "minimum": -10000,
                    "maximum": 10000
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "addons.removePlace"
          }
        }
      },
      "then": {
        "properties": {
          "expectedRevision": {
            "type": "null"
          },
          "args": {
            "description": "P18 discover. Removes a saved place (its finds stay in the progress file).",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "addonId",
              "placeId"
            ],
            "properties": {
              "addonId": {
                "$ref": "addons.schema.json#/$defs/addonId"
              },
              "placeId": {
                "$ref": "addons.schema.json#/$defs/placeId"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "commandType": {
      "enum": [
        "gears.shiftUp",
        "gears.shiftDown",
        "camera.next",
        "camera.setMode",
        "camera.look",
        "mod.setActive",
        "routes.apply",
        "routes.preview",
        "ui.openPanel",
        "ui.closePanel",
        "profile.update",
        "rideSettings.update",
        "appearance.select",
        "devices.configure",
        "devices.assign",
        "devices.disconnect",
        "activities.finish",
        "workouts.select",
        "player.teleport",
        "player.waypoint",
        "player.clearWaypoint",
        "addons.setEnabled",
        "addons.configure",
        "addons.saveSegment",
        "addons.removeSegment",
        "addons.savePlace",
        "addons.removePlace"
      ]
    },
    "routeId": {
      "description": "Base catalog course id (CourseInfo.Id, ushort without the reverse bit 0x8000) as decimal string.",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,4})$"
    },
    "panel": {
      "description": "Allowlisted PC panels only. No workout selector, no confirmation dialogs.",
      "enum": [
        "routes"
      ]
    },
    "catalogKey": {
      "description": "Opaque key of a mod-provided list entry (bike/character name as listed by the mod).",
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "sensorRole": {
      "enum": [
        "power",
        "resistance",
        "cadence",
        "heartRate",
        "steering",
        "controls",
        "runningSpeed"
      ]
    },
    "assignSensorType": {
      "description": "BLE sensor types the mod derives from an advertisement (BLE_Receiver DeviceFactory), as GTBikeV.Devices.SensorDeviceType names them. ANT-only types (STZ) and SPD are not assignable.",
      "enum": [
        "FEC",
        "CPS",
        "HR",
        "CAD",
        "BTS",
        "KICKR",
        "CTRLS",
        "FPOD"
      ]
    },
    "bleAddress": {
      "description": "48-bit BLE address as decimal string (Windows BluetoothAddress = the phone's MAC read as one hex number). 0 is the receiver wildcard and is not allowed; the bridge also rejects values above 2^48-1.",
      "type": "string",
      "pattern": "^[1-9][0-9]{0,14}$"
    }
  }
